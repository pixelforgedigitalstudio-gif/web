# Copy this file to ".env" to turn on AI-graded descriptions.
#
# Without a key, TiPi uses its built-in heuristic for the "Description" score
# and spends ZERO tokens — everything else works exactly the same.
#
# With a key, the dev server scores descriptions via Claude Haiku 4.5
# (cheap + cached, so each listing is graded at most once). The key stays on
# the server and is never exposed to the browser.

ANTHROPIC_API_KEY=sk-ant-your-key-here
